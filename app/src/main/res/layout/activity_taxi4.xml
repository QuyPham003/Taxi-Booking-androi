<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="418dp" />

        <EditText
            android:id="@+id/editCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vị trí hiện tại"
            android:inputType="text"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/editTextDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập điểm đến"
            android:inputType="text"
            android:textSize="20sp" />

        <!-- Spinner for vehicle selection -->
        <Spinner
            android:id="@+id/spinnerVehicleType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:entries="@array/vehicle_types" />

        <TextView
            android:id="@+id/textViewDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quảng đường: "
            android:textColor="#4CAF50"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/textViewCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chi phí: "
            android:textColor="#2196F3"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="384dp"
            android:layout_height="wrap_content"
            android:text="Xác nhận đặt xe" />

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="384dp"
            android:layout_height="wrap_content"
            android:text="trở về" />
    </LinearLayout>
</RelativeLayout>
