<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"> <!-- Set a light background color -->

    <!-- Customer Name TextView -->
    <TextView
        android:id="@+id/tvCustomerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:layout_marginTop="16dp"/>

    <!-- Phone Number TextView -->
    <TextView
        android:id="@+id/tvPhoneNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:layout_marginTop="8dp"/>

    <!-- EditText for new name -->

    <EditText
        android:id="@+id/etNewName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên mới"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:padding="16dp"
        android:textSize="16sp"/>

    <!-- Button to change name -->

    <!-- Confirm Button for changing name -->
    <Button
        android:id="@+id/btnChangeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#03A9F4"
        android:elevation="4dp"
        android:onClick="onChangeNameClicked"
        android:padding="16dp"
        android:text="Đổi tên"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnConfirmChangeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xác nhận"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:backgroundTint="#4CAF50"
        android:elevation="4dp"
        android:padding="16dp"
        android:onClick="onConfirmChangeNameClicked"/>

    <!-- EditText for new password -->
    <EditText
        android:id="@+id/etNewPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập mật khẩu mới"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:padding="16dp"
        android:textSize="16sp"/>

    <!-- Button to change password -->
    <Button
        android:id="@+id/btnChangePassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đổi mật khẩu"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:backgroundTint="#03A9F4"
        android:elevation="4dp"
        android:padding="16dp"
        android:onClick="onChangePasswordClicked"/>

    <!-- Confirm Button for changing password -->
    <Button
        android:id="@+id/btnConfirmChangePassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xác nhận"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:backgroundTint="#4CAF50"
        android:elevation="4dp"
        android:padding="16dp"
        android:onClick="onConfirmChangePasswordClicked"/>

    <!-- Logout Button -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đăng xuất"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp"
        android:backgroundTint="#F44336"
        android:elevation="4dp"
        android:padding="16dp"/>
</LinearLayout>
